# =============================================================================
# Django (наш проект)
# =============================================================================

# Локальная БД SQLite (используется только для разработки без контейнера).
# В контейнере данные лежат в Postgres и в volume — в репозиторий не попадают.
*.sqlite3
*.sqlite3-journal
db.sqlite3

# Логи
*.log

# Локальные настройки, если кто-то использует
local_settings.py

# Собранная статика — генерируется командой collectstatic при сборке образа.
# Исходники CSS/JS лежат в mappy/static/ и они должны быть в git.
/staticfiles/

# Загружаемая пользователями медиа: карты областей, планы этажей, иконки устройств.
# Это пользовательские данные конкретной инсталляции, не код.
# Сохраняем структуру папок (через .gitkeep), но не сами файлы.
/media/*
!/media/.gitkeep
!/media/*/
/media/*/*
!/media/*/.gitkeep

# Translations
*.mo
*.pot

# =============================================================================
# Окружения и секреты
# =============================================================================

# Виртуальные окружения Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Файлы с секретами и переменными окружения.
# .env.example закоммичен как шаблон, реальный .env — нет.
.env
.env.*
!.env.example
.envrc

