# Скопируйте в .env и при необходимости отредактируйте:
#   cp .env.example .env

# === Django ===
DJANGO_SECRET_KEY=replace-me-with-a-real-secret-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# === База данных ===
# Чтобы использовать PostgreSQL — DB_ENGINE=postgresql.
# Чтобы использовать SQLite (без Postgres) — закомментируйте DB_ENGINE.
DB_ENGINE=postgresql
DB_NAME=webmap
DB_USER=webmap
DB_PASSWORD=webmap_pass
DB_HOST=db
DB_PORT=5432
